<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Day Route Form View: Add Required Vehicle next to Person -->
    <record id="fsm_route_dayroute_form_vehicle" model="ir.ui.view">
        <field name="name">fsm.route.dayroute.form.vehicle</field>
        <field name="model">fsm.route.dayroute</field>
        <field name="inherit_id" ref="fieldservice_route.fsm_route_dayroute_form" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='person_id']" position="after">
                <field name="vehicle_id" required="1" />
            </xpath>
        </field>
    </record>

    <!-- Day Route List View: Add Vehicle Column -->
    <record id="fsm_route_dayroute_list_vehicle" model="ir.ui.view">
        <field name="name">fsm.route.dayroute.list.vehicle</field>
        <field name="model">fsm.route.dayroute</field>
        <field name="inherit_id" ref="fieldservice_route.fsm_route_dayroute_list" />
        <field name="arch" type="xml">
            <xpath expr="//field[@name='person_id']" position="after">
                <field name="vehicle_id" optional="show" />
            </xpath>
        </field>
    </record>

    <!-- Enable Multi-Edit on Order List View ONLY for the 3 Key Fields -->
    <record id="fsm_order_list_multi_edit_vehicle" model="ir.ui.view">
        <field name="name">fsm.order.list.multi.edit.vehicle</field>
        <field name="model">fsm.order</field>
        <field name="inherit_id" ref="fieldservice.fsm_order_list_view" />
        <field name="arch" type="xml">
            <!-- 1. Enable multi-edit mode on the list view -->
            <xpath expr="//list" position="attributes">
                <attribute name="multi_edit">1</attribute>
            </xpath>

            <!-- 2. Lock down non-key fields so they CANNOT be batch edited -->
            <xpath expr="//field[@name='name']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='location_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='stage_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='company_id']" position="attributes">
                <attribute name="readonly">1</attribute>
            </xpath>

            <!-- 3. Add vehicle_id next to person_id for multi-editing -->
            <xpath expr="//field[@name='person_id']" position="after">
                <field name="vehicle_id" optional="show" />
            </xpath>
        </field>
    </record>
</odoo>
